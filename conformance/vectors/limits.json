{
 "suite": "limits",
 "spec": "transport.md#transport.limits",
 "detector_vectors": [
  {
   "id": "frame-size-at-limit",
   "note": "exactly 1 MiB is accepted by the detector",
   "input": [
    {
     "hex": "1b5f8a4c554d454e01f38000100000"
    },
    {
     "fill": "61",
     "count": 1048576
    }
   ],
   "events": [
    {
     "frame": {
      "kind": 128,
      "payload": {
       "fill": "61",
       "count": 1048576
      }
     }
    }
   ]
  }
 ],
 "track0_vectors": [
  {
   "id": "string-at-cap",
   "kind": 128,
   "payload": [
    {
     "hex": "1000"
    },
    {
     "fill": "61",
     "count": 4096
    }
   ],
   "expect": {
    "ok": "paragraph"
   }
  },
  {
   "id": "string-over-cap",
   "kind": 128,
   "payload": [
    {
     "hex": "1001"
    },
    {
     "fill": "61",
     "count": 4097
    }
   ],
   "expect": {
    "error": "string_too_long"
   }
  },
  {
   "id": "declared-length-over-cap-no-body",
   "kind": 128,
   "payload": [
    {
     "hex": "ffff"
    }
   ],
   "expect": {
    "error": "string_too_long"
   }
  },
  {
   "id": "sealed-range-kind",
   "kind": 127,
   "payload": [
    {
     "hex": "00026869"
    }
   ],
   "expect": {
    "error": "sealed_kind"
   }
  },
  {
   "id": "unknown-unsealed-kind",
   "kind": 131,
   "payload": [
    {
     "hex": "00026869"
    }
   ],
   "expect": {
    "error": "unknown_kind"
   }
  },
  {
   "id": "trailing-bytes",
   "kind": 128,
   "payload": [
    {
     "hex": "0002686900"
    }
   ],
   "expect": {
    "error": "malformed"
   }
  },
  {
   "id": "esc-in-text",
   "kind": 128,
   "payload": [
    {
     "hex": "0003611b62"
    }
   ],
   "expect": {
    "error": "control"
   }
  },
  {
   "id": "c1-in-text",
   "kind": 128,
   "payload": [
    {
     "hex": "000461c29b62"
    }
   ],
   "expect": {
    "error": "control"
   }
  },
  {
   "id": "invalid-utf8",
   "kind": 128,
   "payload": [
    {
     "hex": "0001ff"
    }
   ],
   "expect": {
    "error": "not_utf8"
   }
  },
  {
   "id": "bad-heading-level",
   "kind": 129,
   "payload": [
    {
     "hex": "07000174"
    }
   ],
   "expect": {
    "error": "bad_level"
   }
  }
 ],
