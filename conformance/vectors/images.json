 "reply_vectors": [
  {
   "id": "one-frame-exact",
   "note": "one frame of exactly width * height * 4 bytes is accepted",
   "reply": {
    "status": 0,
    "width": 2,
    "height": 1,
    "stride": 8,
    "data_len": 8
   },
   "body_bytes": 8,
   "exited_ok": true,
   "reserved": 8,
   "cap": 1048576,
   "expect": {
    "image": [
     2,
     1
    ]
   }
  },
  {
   "id": "second-frame-appended",
   "note": "a second frame's pixels after the first (an animation's later frames) make the body longer than the announced data: crash, alt text for the rest of the command",
   "reply": {
    "status": 0,
    "width": 2,
    "height": 1,
    "stride": 8,
    "data_len": 8
   },
   "body_bytes": 16,
   "exited_ok": true,
   "reserved": 8,
   "cap": 1048576,
   "expect": {
    "crash": "bad_reply"
   }
  },
  {
   "id": "header-announces-both-frames",
   "note": "a header that announces two frames' worth of data against a one-frame reservation is a crash",
   "reply": {
    "status": 0,
    "width": 2,
    "height": 1,
    "stride": 8,
    "data_len": 16
   },
   "body_bytes": 16,
   "exited_ok": true,
   "reserved": 8,
   "cap": 1048576,
   "expect": {
    "crash": "bad_reply"
   }
  },
  {
   "id": "trailing-metadata-bytes",
