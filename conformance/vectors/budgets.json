{
 "suite": "budgets",
 "spec": "security.md#security.limits",
 "notes": [
  "Sizes are bytes. 'who' is local, signed:<id> or unsigned:<id>. 'amount' is a number or, past 2^53, a decimal string.",
  "The shares are integers: the local reserve is a quarter of the budget rounded up, a producer holds at most half of the rest (rounded down), unsigned producers hold at most a quarter (rounded down) between them and that quarter divided by the visible panes each.",
  "Rates are sliding windows of 1000 ms. A value taken at t counts until t+1000. A refused amount is not counted. A clock that goes backwards counts as no time passing.",
  "An unsigned producer's rates are a quarter of 2000 frames and 8 MiB per second, divided by the visible panes."
 ],
 "ledger_vectors": [
  {
   "id": "blocks-local-fills-the-whole-budget",
   "note": "the terminal may use all of it when producers hold nothing; one more is over capacity; releasing makes room",
   "ops": [
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "local",
     "amount": 100000,
     "expect": "ok",
     "tag": "all"
    },
    {
     "op": "used",
     "resource": "blocks",
     "expect": 100000
    },
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "local",
     "amount": 1,
     "expect": "over_capacity"
    },
    {
     "op": "release",
     "tag": "all"
    },
    {
     "op": "used",
     "resource": "blocks",
     "expect": 0
    },
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "local",
     "amount": 1,
     "expect": "ok"
    }
   ]
  },
  {
   "id": "blocks-one-producer-holds-half-of-the-remainder",
   "note": "a producer may hold 37500 (half of 75000); one more is the producer share",
   "ops": [
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "signed:1",
     "amount": 37500,
     "expect": "ok"
    },
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "signed:1",
     "amount": 1,
     "expect": "producer_share"
    },
    {
     "op": "used",
     "resource": "blocks",
     "expect": 37500
    }
   ]
  },
  {
   "id": "blocks-producers-cannot-reach-the-local-reserve",
   "note": "two producers fill 75000 of 75000; a third that would pass 75000 is refused by the reserve; the terminal still gets exactly 25000",
   "ops": [
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "signed:1",
     "amount": 37500,
     "expect": "ok"
    },
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "signed:2",
     "amount": 37500,
     "expect": "ok"
    },
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "signed:3",
     "amount": 1,
     "expect": "local_reserve"
    },
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "local",
     "amount": 25000,
     "expect": "ok"
    },
    {
     "op": "reserve",
     "resource": "blocks",
     "who": "local",
     "amount": 1,
     "expect": "over_capacity"
    }
   ]
  },
  {
   "id": "blocks-unsigned-producers-share-a-quarter",
