# Bright shell integration for zsh.
#
# Bright starts zsh with ZDOTDIR pointing at the directory of this file, so this
# runs first. It puts ZDOTDIR back where the user had it, reads the user's own
# .zshenv, and adds the prompt marks. None of the user's files is changed, and
# every file zsh reads after this one is the user's own.

if [[ -n ${BRIGHT_USER_ZDOTDIR+x} ]]; then
  if [[ -n $BRIGHT_USER_ZDOTDIR ]]; then
    ZDOTDIR=$BRIGHT_USER_ZDOTDIR
  else
    unset ZDOTDIR
  fi
fi
unset BRIGHT_USER_ZDOTDIR

if [[ -r "${ZDOTDIR:-$HOME}/.zshenv" ]]; then
  source "${ZDOTDIR:-$HOME}/.zshenv"
fi

# The marks: OSC 133 A (prompt start), B (prompt end, where the command is
# typed), C (command start) and D with the exit status (command end), and OSC 7
# with the working directory.
if [[ -o interactive && -t 1 && -z ${_bright_marks-} ]]; then
  typeset -g _bright_marks=1 _bright_ran=
  typeset -g _bright_b=$'%{\e]133;B\a%}'

  # _bright_url PATH: the path with every byte outside the safe set as %XX, in REPLY.
  _bright_url() {
    emulate -L zsh
    local LC_ALL=C s=$1 c out= i
    for (( i = 1; i <= ${#s}; i++ )); do
      c=${s[i]}
      case $c in
        [a-zA-Z0-9/._~-]) out+=$c ;;
        *) out+=$(printf '%%%02X' "'$c") ;;
      esac
    done
    REPLY=$out
  }

  _bright_precmd() {
    local last=$?
    if [[ -n $_bright_ran ]]; then
      print -rn -- $'\e]133;D;'$last$'\a'
      _bright_ran=
    fi
    _bright_url $PWD
    print -rn -- $'\e]7;file://'${HOST}$REPLY$'\a'$'\e]133;A\a'
    # The end of the prompt is marked once, whatever the prompt is by now.
    PS1=${PS1//$_bright_b/}$_bright_b
  }

  _bright_preexec() {
    _bright_ran=1
    print -rn -- $'\e]133;C\a'
  }

  autoload -Uz add-zsh-hook 2>/dev/null
  add-zsh-hook precmd _bright_precmd
  add-zsh-hook preexec _bright_preexec
fi
